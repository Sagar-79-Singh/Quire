{
  "name": "quire",
  "version": "1.0.1",
  "private": true,
  "description": "A thoughtful, offline desktop document editor.",
  "author": "Sagar <s07909084193@gmail.com> (https://github.com/Sagar-79-Singh)",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --host 0.0.0.0",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux --x64",
    "build:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0"
  },
  "dependencies": {
    "docx": "9.5.1",
    "mammoth": "1.9.1",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.8",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.9",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "autoprefixer": "10.4.21",
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.0",
    "eslint": "8.57.1",
    "jsdom": "26.1.0",
    "playwright": "1.54.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "@types/jsdom": "21.1.7"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@electron/node-gyp": "https://codeload.github.com/electron/node-gyp/tar.gz/06b29aafb7708acef8b3669835c8a7857ebc92d2"
  }
}
